# انسخ هذا الملف باسم .env وعدّل القيم. ملف .env لا يُرفع على Git.

# منفذ الخادم
PORT=3000

# الرابط الذي يفتح منه المستخدمون النظام (يُستخدم في روابط استعادة كلمة المرور)
PUBLIC_URL=http://localhost:3000

# مفتاح Google Gemini للمساعد الذكي (يمكن أيضاً إدخاله من شاشة إعدادات الذكاء الاصطناعي)
GEMINI_API_KEY=

# مدة صلاحية جلسة الدخول بالأيام
SESSION_TTL_DAYS=30

# مسار قاعدة البيانات (الافتراضي: backend/data/palmtrace.db)
# DB_PATH=

# قاعدة بيانات جديدة فارغة: true = تحميل مزرعة تجريبية كاملة (مستخدمون بكلمة مرور 1234)
# false (الافتراضي) = حساب مدير واحد بكلمة مرور مؤقتة تظهر في نافذة الخادم عند أول تشغيل
SEED_DEMO_DATA=false

# كلمة مرور كل حسابات المزرعة التجريبية (ضعها على أي خادم منشور على الإنترنت؛ الافتراضي 1234)
# DEMO_PASSWORD=

# عند عدم ضبط البريد: طباعة رابط استعادة كلمة المرور في نافذة الخادم فقط (true/false)
LOG_RESET_LINKS=true

# البريد الإلكتروني (لإرسال روابط استعادة كلمة المرور)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PalmTrace" <noreply@example.com>

# قاعدة PostgreSQL على Render (لسكربتات npm run db:push و db:pull)
# RENDER_PG_URL=postgresql://USER:PASSWORD@HOST/DBNAME
